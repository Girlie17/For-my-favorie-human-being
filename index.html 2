<!DOCTYPE html>
<html lang="eng">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Favorite Human😍</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: Arial, sans-serif;
        background: #0d0612;
        color: white;
        overflow-x: hidden;
      }
      .bg {
        position: fixed;
        inset: 0;
        z-index: -2;
        background: 
          radial-gradient(circle at 20% 20%, #6e164f 0%, transparent 30%),
          radial-gradient(circle at 80% 30%, #31176e 0%, transparent 30%),
          radial-gradient(circle at 50% 80%, #781d58 0%, transparent 35%),
          #0d0612
      }
      .stars {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
      }
      .star {
        position: absolute;
        width: 3px;
        height: 3px;
        background: white;
        border-radius: 50%;
        animation: twinkle 2s infinite alternate;
      }
      @keyframes twinkle {
        from{ opasity: .2; transform: scale(.7);}
        to{ opacity: 1; transform: scale(1.4);}
      }
      nav {
        position: fixed;
        top: 15px;
        left: 15%;
        transform: translateX(-50%);
        width: min(92%,900px);
        padding: 12px 20px;
        border-radius: 30px;
        background: rgba(20,10,25,.75);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,.15);
        z-index: 1000;
        display: flex;
        justify-content: center;
        gap: 20px;
      }
      nav a {
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: .3s;
      }
      nav a:hover {
        color: #ff6db6;
        transform:scale(1.1);
      }
      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 100px 20px;
      }
      .hero-content {
        max-width: 850px;
      }
      .badge {
        display: inline-block;
        padding: 8px 18px;
        border: 1px solid #ff5cab;
        border-radius: 30px;
        color: #ff8bc7;
        margin-bottom: 25px;
      }
      .hero h1 {
        font-size: clamp(50px,10vw,110px);
        line-height: .9;
        margin-bottom: 25px;
        background: linear-gradient(90deg, #ff7bbb, #fff, #ff7bbb);
        background-size: 200%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: gradient 4s infinite linear;
      }
      @keyframes gradient {
        to{ background-position: 200%;}
      }
      .hero p {
        font-size: 20px;
        opacity: .8;
        margin-bottom: 35px;
      }
      .btn {
        border: none;
        padding: 15px 28px;
        border-radius: 30px;
        background: linear-gradient(135deg, #ff4fa3, #8c43ff);
        color: white;
        font-size: 16px;
        cursor: pointer;
        transition: .3s;
        box-shadow: 0 10px 30px rgba(255,60,160,.25);
      }
      .btn:hover {
        transform: translateY(-4px) scale(1.05);
      }
      section {
        padding: 100px 20px;
        max-width: 1100px;
        margin: auto;
      }
      .section-title {
        font-size: 42px;
        text-align: center;
        margin-bottom: 50px;
      }
      .section-title span {
        color: #ff62b3;
      }
      .letter {
        max-width: 750px;
        margin: auto;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        padding: 45px;
        border-radius: 25px;
        line-height: 1.8;
        box-shadow: 0 20px 70px rgba(0,0,0,.3);
      }
      .letter p{
        margin-bottom: 20px;
      }
      .reasons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
        gap: 20px;
      }
      .reason {
        padding: 20px;
        border-radius: 20px;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        transition: .3s;
      }
      .reason:hover {
        transform: translateY(-8px) rotate(-1deg);
        background: rgba(255,72,168,.1);
      }
      .reason-number {
        color: #ff62b3;
        font-size: 14px;
        margin-bottom: 10px;
      }
      .quiz-box {
        max-width: 700px;
        margin: auto;
        text-align: center;
        background: rgba(255,255,255,.06);
        padding: 40px;
        border-radius: 25px;
      }
      .question {
        font-size: 25px;
        margin-bottom: 25px;
      }
      .answers {
        display: grid;
        gap: 12px;
      }
      .answer {
        padding: 15px;
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,.15);
        background: rgba(255,255,255,.05);
        color: white;
        cursor: pointer;
        transition: .2s;
      }
      .answer:hover {
        background: rgba(255,82,175,.2);
      }
      .chaos-zone {
        text-align: center;
      }
      #runaway {
        position: relative;
      }
      #chaosMessage {
        margin-top: 25px;
        min-height: 30px;
        color: #ff79bb;
      }
      .meter {
        max-width: 700px;
        margin: auto;
      }
      .meter-bar {
        height: 35px;
        background: rgba(255,255,255,.1);
        border-radius: 30px;
        overflow: hidden;
      }
      .meter-fill {
        width: 0%;
        height: 100%;
        background: linear-gradient(90deg, #ff3f9d, #a75aff);
        border-radius: inherit;
        transition: width 2s;
      }
      .meter-text {
        text-align: center;
        margin-top: 20px;
        font-size: 25px;
      }
      .counter {
        text-align: center;
      }
      .counter-number {
        font-size: 70px;
        color: #ff67b4;
      }
      .secret {
        text-align: center;
      }
      .secret-box {
        display: none;
        margin-top: 30px;
        padding: 30px;
        border-radius: 20px;
        background: rgba(255,70,170,.12);
        border: 1px solid #ff55aa;
      }
      footer {
        text-align: center;
        padding: 70px 20px;
        opacity: .7;
      }
      .heart {
        position: fixed;
        pointer-events: none;
        animation: floatHeart 3s linear forwards;
        z-index: 9999;
      }
      @keyframes floatHeart {
        from {
          transform: translateY(0) scale(1);
          opacity: 0;
        }
        to {
          transform: translateY(-400px) scale(1.8);
          opasity: 0;
        }
      }
      @media(max-width:600px) {
        nav {
          gap: 10px;
          padding: 10px;
        }
        nav a {
          font-size: 11px;
        }
        .lettter {
          padding: 25px;
        }
        .section-title {
          font-size: 32px;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg"></div>
    <div class="stars" id="stars"></div>
    <nav>
      <a href="#home">Home</a>
      <a href="#letter">Letter</a>
      <a href="#reasons">Reasons</a>
      <a href="#quiz">Quiz</a>
      <a href="#chaos">Chaos</a>
    </nav>
    <section class="hero" id="home">
      <div class="hero-content">
        <div class="badge">
          ⚠️Extremly Important Website
        </div>
        <h1>HEY YOU</h1>
        <p>
          yes,you. The rediculously cute human currently reading this.
        </p>
        <button class="btn"
        onclick="scrollToSection('letter')">
        Enter at your own risk😜
      </button>
      </div>
    </section>
    <section id="letter">
      <h2 class="section-title">
        A little <span>letter</span>
      </h2>
      <div class="letter">
        <p>
          Hey, love😘
        </p>
        <p>
          I wanted to make something that feels a little more like <i>us</i> -silly,chaotic,sweet,slightly embarrassing,and probably way more complicated than necessary.
        </p>
        <p>
          You mean so much to me. Even when you annoy me.
          Especially when you annoy me.
          Actually...unfortunatly, you annoy me quite often.
        </p>
        <p>
          But somehow you're still my favorite person.
        </p>
        <p>
          So this website is basically a giant digital reminder that somewhere out there is one VERY vute person who thinks you're pretty damn special.
        </p>
        <p>
          And yes.
          That person is me.
        </p>
        <p>
          - Forever your favorite girl💞
        </p>
      </div>
    </section>
    <section id="reasons">
      <h2 class="section-title">
        Reasons I <span>love you</span>
      </h2>
      <div class="reasons">
        <div class="reason">
          <div class="reason-number">01</div>
        <h3>Your personality</h3>
        <p>You somehow manage to make ordinary conversations completely chaotic.</p>
        </div>
        

      <div class="reason">
        <div class="reason-number">02</div>
        <h3>Your smile</h3>
        <p>Honestly unfair. You should probably be fined for being that cute.</p>
      </div>
      <div class="reason">
        <div class="reason-number">03</div>
        <h3>Your voice</h3>
        <p>Could listen to you talk about absolutely nothing for hours.</p>
      </div>
      <div class="reason">
        <div class="reason-number">04</div>
        <h3>Your existence</h3>
        <p>Apparently you decided to exist and completely ruin my ability to be normal haha.</p>
      </div>
      <div class="reason">
        <div class="reason-number">05</div>
        <h3>The little things</h3>
        <p>The random messages, jokes, conversations and tiny moments.</p>
      </div>
      <div class="reason">
        <div class="reason-number">06</div>
        <h3>because you are YOU</h3>
        <p>And honestly, that's already enough.</p>
      </div> 
      </div>
    </section>
    <section>
      <h2 class="section-title">
        Offivial <span>Love Meter</span>
      </h2>
      <div class="meter">
        <div class="meter-bar">
          <div class="meter-fill" id="loveFill"></div>
        </div>
        <div class="meter-text" id="loveText">
          Colculating...
        </div>
      </div>
    </section>
    <section>
      <div class="counter">
        <h2 class="section-title">
          Amount of times you've made me smile
        </h2>
        <div class="counter-number" id="counter">
          0
        </div>
        <p>
          The counter is completely scientific.
          Trust me.
        </p>
      </div>
    </section>
    <section id="Quiz">
      <h2 class="section-title">
        How well do you know <span>us?</span>
      </h2>
      <div class="quiz-box">
        <div class="question" id="question">
          Loading question...
        </div>
        <div class="answers" id="answers"></div>
        <p id="quizResult" style="margin-top: 25px;"></p>
      </div>
    </section>
    <section id="Chaos">
      <h2 class="section-title">
        The <span>Chaos Department</span>
      </h2>
      <div class="chaos-zone">
        <p style="margin-bottom: 30px;">
          Press the button if you dare
        </p>
        <button class="btn" id="runaway">
          Don't click me pls
        </button>
        <p id="chaosMessage"></p>
      </div>
    </section>
    <section class="secret">
      <h2 class="section-title">
        There may be a <span>secret...</span>
      </h2>
      <button class="btn" onclick="openSecret()">
        Open Secret🔐
      </button>
      <div class="secret-box" id="secretBox">
        <h2>You found it👀</h2>
        <br>
        <p>
          I love you more than I know how to show.
        </p>
        <br>
        <p>
          And yes, you are stuck with me now.
        </p>
        <br>
        <p style="font-size: 35px;">
          😝
        </p>
      </div>
    </section>
    <footer>
      <p>
        Made with love, questionable amount of JavaScript and sleep,
        and unquestonable amount of feelings.
      </p>
      <br>
      <p>
        ©️ Your girlfriend's extremly serious corporation.
      </p>
    </footer>
    <script>
      const star = document.getElementById("stars");
      for(let i = 0; i < 100; i++){
        const star = document.createElement("div");
        star.className="star";
        star.style.left = Math.random()*100+"%";
        star.style.top = Math.random()*100+"%";
        star.style.animationDelay = Math.random()*2+"s";
        stars.appendChild(star);
      }
      function scrollToSection(id){
        document.getElementById(id).scrollIntoView({behavior:"smooth"});
      }
      document.addEventListener("click", function(e){
        if(e.target.tagName === "BUTTON"){
          for(let i=0;i<5;i++){
            const Heart = document.createElement("div");
            heart.className="heart";
            heart.innerHTML="❤️";
            heart.style.left=(e.clientX+Math.random()*60-30)+"px";
            heart.style.top=(e.clientY+Math.random()*30-15)+"px";
            heart.style.fontSize=(15+Meth.random()*20)+"px";
            document.body.appendChild(heart);
            setTimeout(() => heart.remove(), 3000);
          }
        }
      });
      setTimeout(() => {
        document.getElementById("loveFill").style.width ="100%";
        document.getElementById("loveText").innerText = "ERROR:TOO MUCH LOVE❤️";
      }, 700);
      let count =0;
      const counter = document.getElementById("counter");
      const interval = setInterval(() => {
        count++;
        counter.innerText = count;
        if(count >=999){
          clearInterval(interval);
        }
      }, 5);
      const quiz = [
        {
          question:"Who is the cutes person?",
          answers:[
            "You",
            "Me",
            "Obviously both",
            "A random penguin"
          ],
          correct: 4
        },
        {
          question:"Who is more likely to start an argument over something stupid?",
          answers:[
            "Me",
            "You",
            "Both of us",
            "The penguin"
          ],
          correct:4
        },
        {
          question:"What's the correct ammount of love?",
          answers:[
            "50%",
            "100%",
            "500%",
            "PENGUIN"
          ],
          correct:4
        },
        {
          question:"What should we do when we're bored?",
          answers:[
            "Sleep",
            "Talk",
            "Become penguins",
            "Cause chaos"
          ],
          correct:3
        }
      ];
      let currentQuestion=0;
      let score=0;
      function loadQuestion(){
        const q = quiz[currentQuestion];
        document.getElementById("question").innerText=q.question;
        const answers=document.getElementById("answers");
        answers.innerHTML="";
        q.answers.forEach((answer,index)=>{
          const button=document.createElement("button");
          button.className="answer";
          button.innerText=answer;
          button.onclick=()=>checkAnswer(index);
          answers.appendChild(button);
        });
      }
      function checkAnswer(index){
        const q = quiz[currentQuestion];
        // quiz.correct is 1-based; compare accordingly
        if(index === (q.correct - 1)){
          score++;
          document.getElementById("quizResult").innerText="CORRECT❤️";
        }else{
          document.getElementById("quizResult").innerText="Wrong😭 But I'll forgive you.";
        }
        currentQuestion++;
        if(currentQuestion < quiz.length){
          setTimeout(loadQuestion,700);
        }else{
          setTimeout(()=>{
            document.getElementById("question").innerText="Quiz complete!";
            document.getElementById("answers").innerHTML="";
            document.getElementById("quizResult").innerText = `You scored ${score}/${quiz.length}`;
          },700);
        }
      }
      loadQuestion();
      const runaway = document.getElementById("runaway");
      const messages=[
        "Nice try😭",
        "NOPE😝",
        "You thought you could click?😂",
        "Absolutely not😤",
        "Why are you chasing me?😳",
        "skill issue?😏",
        "HAHAHAHAHA!😎",
        "You can't catch me!😜",
        "Try again!😝",
        "hehehe"
      ];
      runaway.addEventListener("mouseover",()=>{
        const x=Math.random()*window.innerWidth;
        const y=Math.random()*window.innerHeight;
        runaway.style.left=x+"px";
        runaway.style.top=y+"px";
        const message=messages[Math.floor(Math.random()*messages.length)];
        document.getElementById("chaosMessage").innerText=message;
      });
      function openSecret(){
        const secretBox=document.getElementById("secretBox");
        secretBox.style.display="block";
      }
      let secretCode=[
        "ArrowUp",
        "ArrowUp",
        "ArrowDown",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "ArrowLeft",
        "ArrowRight",
      ];
      document.addEventListener("keydown",e=>{
        secretCode.push(e.key);
        if(secretCode.slice(-8).join("") === "ArrowUpArrowUpArrowDownArrowDownArrowLeftArrowRightArrowLeftArrowRight"){
          openSecret();
        }
        
      })
    </script>
  </body>
</html>